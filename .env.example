# Brainagram: configuration through environment variables.
# Copy to `.env` (ignored by git) and adjust. With Docker:
#   docker run --env-file .env -p 4000:4000 brainagram
# The docker-compose.yml in this repository already reads `.env`.

# ── Required ─────────────────────────────────────────────────────────────────

# Secret for cookies and sessions: at least 64 bytes.
#   mix phx.gen.secret      (or: openssl rand -base64 48)
SECRET_KEY_BASE=

# Public host name, without https:// (used to build absolute URLs).
# For a local test: localhost
PHX_HOST=localhost

# ── Database ─────────────────────────────────────────────────────────────────

# Without DATABASE_URL the container runs its own PostgreSQL, with the data in
# /app/data (mount a volume there). To use an external database (managed
# Postgres, Coolify, RDS, Neon, Supabase…), uncomment and fill in:
#
#   DATABASE_URL=ecto://USER:PASSWORD@HOST:5432/DATABASE
#   (postgres://… works too; special characters in the password must be
#   percent-encoded, e.g. @ becomes %40)
#
# Migrations run on start. The database must already exist and the user must
# be able to create tables.
# DATABASE_URL=

# TLS to the database (most managed services require it):
#   false   (default) no TLS, database on the same network
#   true    encrypt, without checking the server certificate
#   verify  encrypt and check the certificate (system CAs)
# DATABASE_SSL=false
# For a database with its own CA (with DATABASE_SSL=verify): path, inside the
# container, of the CA certificate that signed the server's.
# DATABASE_SSL_CA_FILE=/certs/ca.crt

# Concurrent database connections.
# POOL_SIZE=10

# true if the database host is IPv6-only.
# ECTO_IPV6=false

# ── Server ───────────────────────────────────────────────────────────────────

# HTTP port inside the container.
# PORT=4000

# Origins allowed to open the LiveView WebSocket (comma-separated). Without it,
# the request's own host is accepted, so the Coolify domain works even when
# PHX_HOST is different.
# PHX_CHECK_ORIGIN=https://brainagram.example.com

# ── Demo mode ────────────────────────────────────────────────────────────────

# true = public playground: no database (DATABASE_URL is ignored), diagrams in
# a temporary in-memory cache, visible to everyone, erased after 24 h without
# changes and on every restart, with a notice on every screen. Only for the
# demo instance.
# BRAINAGRAM_DEMO=false
