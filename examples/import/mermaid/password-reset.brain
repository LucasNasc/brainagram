diagram sequence "Password reset"

actor       U "User"
participant W "Web App"
participant A "Auth API"
participant M "Mail Service"

step "Forgot password" {
  U -> W : Forgot password
  W -> A : POST /password-resets
}

step "email exists" {
  A ->> M : send reset link
  A --> W : 202 Accepted
}

step "unknown email" {
  A --> W : 202 Accepted (same answer)
}

step "never reveal whether the email exists" {
  note over W, A : never reveal whether the email exists
  W --> U : Check your inbox
}
